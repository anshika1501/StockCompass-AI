

# PostgreSQL connection (used by backend + docker-compose)
POSTGRES_DB=stocks
POSTGRES_USER=stocks_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DJANGO_DB_ENGINE=postgresql



OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=tinyllama
# OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# Deployment Settings
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=stockcompass-api.anshikapriya.online,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://stockcompass.anshikapriya.online,http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=https://stockcompass.anshikapriya.online
